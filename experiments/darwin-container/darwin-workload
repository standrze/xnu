#!/usr/bin/env python3
# SPDX-License-Identifier: BSD-2-Clause
"""Build a workload package or delegate to its self-contained runner."""
import os
from pathlib import Path
import sys

here = Path(__file__).resolve().parent
if len(sys.argv) > 1 and sys.argv[1] == "pack":
    os.execv(sys.executable, [sys.executable, str(here / "userland/pack_darwin_workload.py"), *sys.argv[2:]])
if len(sys.argv) > 2 and sys.argv[1] in ("run", "status", "logs", "stop"):
    package = Path(sys.argv[2]).resolve()
    os.execv(sys.executable, [sys.executable, str(package / "darwin"), sys.argv[1], *sys.argv[3:]])
print("Usage: darwin-workload pack SPEC --output PACKAGE\n"
      "       darwin-workload {run,status,logs,stop} PACKAGE [OPTIONS]", file=sys.stderr)
raise SystemExit(2)
