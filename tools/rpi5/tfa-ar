import os
from pathlib import Path
import sys
root = Path(__file__).resolve().parents[2]
os.environ["ZIG_GLOBAL_CACHE_DIR"] = str(root / "build/rpi5/zig-cache")
tool = str(root / "build/rpi5/zig-aarch64-macos-0.16.0/zig")
os.execv(tool, [tool, "ar", *sys.argv[1:]])
