+_Static_assert(__builtin_offsetof(struct ksyn_waitq_element, kwe_flags) == 34, "kwe_flags ABI");
+_Static_assert(__builtin_offsetof(struct ksyn_waitq_element, kwe_lockseq) == 36, "kwe_lockseq ABI");
+_Static_assert(__builtin_offsetof(struct ksyn_waitq_element, kwe_count) == 40, "kwe_count ABI");
+_Static_assert(__builtin_offsetof(struct ksyn_waitq_element, kwe_psynchretval) == 44, "kwe_psynchretval ABI");
