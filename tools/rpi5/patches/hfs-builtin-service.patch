+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef RPI5_HFS_BUILTIN_H
+#define RPI5_HFS_BUILTIN_H
+
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+
+/* Separate from the SD-only diagnostic: no automatic mount or disk writes. */
+static inline bool
+rpi5_hfs_start_allowed(void)
+{
+	int enabled = 0;
+	return PE_parse_boot_argn("bcm2712_hfs", &enabled, sizeof(enabled)) &&
+	    enabled == 1;
+}
+
+#endif
